# Bu dosyayı .env olarak kopyala ve doldur. .env dosyasını ASLA GitHub'a yükleme.
# Railway/Render'da bu değerleri panelden "Variables / Environment" kısmına gir.

# test = gerçek ödeme yapılmaz (log'a yazar). Hazır olunca live yap.
PAYOUT_MODE=test

# FaucetPay API anahtarı (YENİ ürettiğin anahtar). Sadece live modda gerekli.
FAUCETPAY_API_KEY=

# Cloudflare Turnstile. Aşağıdakiler Cloudflare'in "her zaman geçer" TEST anahtarlarıdır.
# Canlıya geçerken Cloudflare panelinde kendi Turnstile sitenden gerçek anahtarları al.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Her çekimde ödenecek miktar, FaucetPay'in en küçük birimi cinsinden (virgülle birden fazla coin).
# Örnek: USDT:10000  (8 ondalık varsayımıyla 0.0001 USDT). Canlıdan önce /admin/balance ile birimi doğrula.
PAYOUT_AMOUNTS=USDT:10000

# Aynı adres VE aynı IP için çekimler arası bekleme (dakika)
COOLDOWN_MINUTES=60

# Günlük toplam çekim sayısı üst sınırı (bakiyeyi korur)
DAILY_MAX_PAYOUTS=50

# Arayüzün yayınlandığı adresler (virgülle). Yerel denemede http://localhost:8080 ekle.
ALLOWED_ORIGINS=https://ryftcoin.com,https://www.ryftcoin.com

# /admin/balance için gizli bir parola (uzun, rastgele). Boş bırakırsan o uç kapalı olur.
ADMIN_TOKEN=

# Railway/Render gibi tek proxy arkasında 1 bırak
TRUST_PROXY=1
