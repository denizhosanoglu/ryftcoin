# Bu dosyayı .env olarak kopyala ve doldur. .env dosyasını ASLA GitHub'a yükleme.
# Render/Railway'de bu değerleri panelden "Environment" kısmına gir.

# FaucetPay API anahtarın (YENİ ürettiğin). Zorunlu.
FAUCETPAY_API_KEY=

# Gösterilecek para birimleri (virgülle). Varsayılan USDT.
BALANCE_CURRENCIES=USDT

# Sayfanın yayınlandığı adresler (virgülle). Yerel denemede http://localhost:8080 ekle.
ALLOWED_ORIGINS=https://ryftcoin.com,https://www.ryftcoin.com
